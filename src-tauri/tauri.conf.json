{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textmint",
  "version": "0.2.0",
  "identifier": "dev.kelsoe.textmint",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Textmint",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 460,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Clean & convert AI text, on-device.",
    "longDescription": "Textmint cleans AI output (invisible Unicode, terminal noise, markdown tells) and converts between formats. Everything runs locally - text never leaves your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
